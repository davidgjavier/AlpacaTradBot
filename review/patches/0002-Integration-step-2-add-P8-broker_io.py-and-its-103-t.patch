+class Clock:
+    def __init__(self):
+        self.t = 1_000.0
+
+    def mono(self):
+        return self.t
+
+    def sleep(self, s):
+        self.sleeps.append(s)
+        self.t += s
+
+    def ns(self):
+        return int(self.t * 1e9)
+
+
+def fast_read_kw(clock):
+    clock.sleeps = []
+    return dict(clock=clock.mono, sleep=clock.sleep, deadline_s=8.0, max_attempts=5)
+
