+        clk.t += 31                                       # past the window: A's stale view takes the "absent" path
+        gw2 = second_gateway(c, db, clk)
+        a_in_lookup, b_done = threading.Event(), threading.Event()
+
+        def hook(name):
+            if name == "A":
+                a_in_lookup.set()
+                b_done.wait(10)                          # A's (stale) 404 returns after B finishes
+        b.lookup_hook = hook
+        out = {}
